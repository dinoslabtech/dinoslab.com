---
import Layout from "@/layouts/Layout.astro";
import PageIntro from "@/components/PageIntro.astro";
import ContactForm from "@/components/ContactForm.astro";
import { site } from "@/data/site";

const steps = [
  {
    title: "Schematic and architecture",
    body: "We sit on the requirements, pick the parts, and draw a schematic that can actually be built.",
  },
  {
    title: "PCB layout",
    body: "Layout for the stack you need — including RF, power, and dense BGA work when the board asks for it.",
  },
  {
    title: "Firmware and software",
    body: "Bring-up, drivers, and the software around the board: agents, Linux, a small UI, whatever the product needs.",
  },
  {
    title: "Prototype",
    body: "A first run you can hold. We iterate until the board behaves.",
  },
  {
    title: "Small series or scale",
    body: "Assembly on the Acme Systems line in Ladispoli. A few tens of boards, or tens of thousands in a month.",
  },
];
---

<Layout
  title="Consulting"
  description="Custom PCB design, firmware, and production in Italy — prototypes through volume."
>
  <div class="shell py-16 lg:py-20">
    <PageIntro kicker="Consulting" title="A full board, not just Gerbers.">
      Hire the studio for a custom PCB. We take it from idea to assembled
      hardware, with firmware and the software that talks to it. Based in
      Ladispoli, near Rome. We work worldwide, in English.
    </PageIntro>
  </div>

  <section class="border-y border-line bg-white">
    <div class="shell py-16 lg:py-20">
      <p class="eyebrow">Process</p>
      <h2 class="mt-3 text-3xl font-medium tracking-tight">What a project looks like</h2>
      <ol class="mt-10 divide-y divide-line border-y border-line">
        {
          steps.map((step, i) => (
            <li class="grid gap-4 py-6 sm:grid-cols-[5rem_1fr] sm:gap-10">
              <span class="font-mono text-sm text-lab">{String(i + 1).padStart(2, "0")}</span>
              <div>
                <h3 class="font-medium tracking-tight">{step.title}</h3>
                <p class="mt-2 max-w-2xl text-sm leading-relaxed text-muted">{step.body}</p>
              </div>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section class="border-b border-line">
    <div class="shell grid gap-10 py-16 lg:grid-cols-12 lg:py-20">
      <div class="lg:col-span-4">
        <p class="eyebrow">Production</p>
        <h2 class="mt-3 text-3xl font-medium tracking-tight">Italy, on a real line.</h2>
      </div>
      <p class="max-w-2xl text-[17px] leading-relaxed text-muted lg:col-span-8">
        Dino’s Lab is independent. We have a production agreement with{" "}
        <a class="text-ink underline decoration-line underline-offset-2 hover:text-lab" href={site.acme.url}>
          {site.acme.name}
        </a>
        {" "}in Ladispoli: SMD pick-and-place, vapour-phase reflow, through-hole,
        and test. That is the same line they use for their own Linux SOMs.
        Most consultancies stop at files. We can hand you assembled boards,
        in Italy, at prototype quantity or at scale.
      </p>
    </div>
  </section>

  <section>
    <div class="shell grid gap-12 py-16 lg:grid-cols-12 lg:py-20">
      <div class="lg:col-span-5">
        <p class="eyebrow">Quote</p>
        <h2 class="mt-3 text-3xl font-medium tracking-tight">Request a quote</h2>
        <p class="mt-4 text-sm leading-relaxed text-muted">
          Describe the board, the quantity, and the deadline. We answer by
          email, SIM, or Telegram.
        </p>
        <dl class="mt-8 divide-y divide-line border-y border-line text-sm">
          <div class="flex justify-between gap-4 py-3">
            <dt class="font-mono text-[11px] uppercase tracking-[0.16em] text-muted">Email</dt>
            <dd>
              <a class="hover:text-lab" href={`mailto:${site.email}`}>{site.email}</a>
            </dd>
          </div>
          <div class="flex justify-between gap-4 py-3">
            <dt class="font-mono text-[11px] uppercase tracking-[0.16em] text-muted">SIM</dt>
            <dd>
              <a class="hover:text-lab" href={`tel:${site.phone.replace(/\s/g, "")}`}>{site.phone}</a>
            </dd>
          </div>
          <div class="flex justify-between gap-4 py-3">
            <dt class="font-mono text-[11px] uppercase tracking-[0.16em] text-muted">Telegram</dt>
            <dd>
              <a class="hover:text-lab" href={site.telegram}>{site.telegramHandle}</a>
            </dd>
          </div>
        </dl>
      </div>
      <div class="panel p-6 sm:p-8 lg:col-span-7">
        <ContactForm name="quote" />
      </div>
    </div>
  </section>
</Layout>
