---
import Layout from "@/layouts/Layout.astro";
import PageIntro from "@/components/PageIntro.astro";
import ContactForm from "@/components/ContactForm.astro";
import ContactLinks from "@/components/ContactLinks.astro";
import { site } from "@/data/site";

const steps = [
  {
    title: "Schematic",
    body: "We go through what the board has to do, pick the parts, and draw something that can actually be built.",
  },
  {
    title: "Layout",
    body: "RF, power, dense BGAs — we lay out the stack the job needs.",
  },
  {
    title: "Firmware and software",
    body: "Bring-up, drivers, and whatever sits on top: a Linux image, a small UI, a service.",
  },
  {
    title: "Prototype",
    body: "A first batch you can hold. We change what doesn’t work.",
  },
  {
    title: "Production",
    body: "Assembly at Acme Systems in Ladispoli. Tens of boards, or tens of thousands a month.",
  },
];
---

<Layout
  title="Consulting"
  description="Custom PCB design, firmware, and assembly in Italy — from the first prototype through production."
>
  <div class="shell py-16 lg:py-20">
    <PageIntro kicker="Consulting" title="Custom boards">
      From the first schematic through assembled hardware. Firmware and
      software if you need them. We’re in Ladispoli; the work can come from
      anywhere.
    </PageIntro>
  </div>

  <section class="border-y border-line bg-panel">
    <div class="shell py-16 lg:py-20">
      <p class="eyebrow">Process</p>
      <h2 class="mt-3 text-3xl font-medium tracking-tight">How a project runs</h2>
      <ol class="mt-10 divide-y divide-line border-y border-line">
        {
          steps.map((step, i) => (
            <li class="grid gap-2 py-6 md:grid-cols-[5rem_1fr] md:gap-10">
              <span class="font-mono text-sm text-lab">{String(i + 1).padStart(2, "0")}</span>
              <div>
                <h3 class="font-medium tracking-tight">{step.title}</h3>
                <p class="mt-2 max-w-2xl text-sm leading-relaxed text-muted">{step.body}</p>
              </div>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section class="border-b border-line">
    <div class="shell grid gap-10 py-16 lg:grid-cols-12 lg:py-20">
      <div class="lg:col-span-4">
        <p class="eyebrow">Production</p>
        <h2 class="mt-3 text-3xl font-medium tracking-tight">Built in Ladispoli</h2>
      </div>
      <p class="max-w-2xl text-[17px] leading-relaxed text-muted lg:col-span-8">
        Dino’s Lab is independent.{" "}
        <a class="text-ink underline decoration-line underline-offset-2 hover:text-lab" href={site.acme.url}>
          {site.acme.name}
        </a>
        {" "}lets us use their line in Ladispoli: pick-and-place, vapour-phase
        reflow, through-hole, test. Same machines they use for their own Linux
        modules. You get assembled boards, not just files.
      </p>
    </div>
  </section>

  <section>
    <div class="shell grid gap-12 py-16 lg:grid-cols-12 lg:py-20">
      <div class="lg:col-span-5">
        <p class="eyebrow">Quote</p>
        <h2 class="mt-3 text-3xl font-medium tracking-tight">Ask for a quote</h2>
        <p class="mt-4 text-sm leading-relaxed text-muted">
          What the board has to do, roughly how many, and when you need it.
          We’ll answer by email, phone, or Telegram.
        </p>
        <div class="mt-8">
          <ContactLinks />
        </div>
      </div>
      <div class="panel p-6 sm:p-8 lg:col-span-7">
        <ContactForm name="quote" />
      </div>
    </div>
  </section>
</Layout>
