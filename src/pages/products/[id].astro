---
import Layout from "@/layouts/Layout.astro";
import ContactForm from "@/components/ContactForm.astro";
import SpecTable from "@/components/SpecTable.astro";
import ProductViewer from "@/components/ProductViewer.astro";
import N6BlockDiagram from "@/components/N6BlockDiagram.astro";
import { getCollection, render } from "astro:content";

export async function getStaticPaths() {
  const products = await getCollection("products");
  return products.map((product) => ({
    params: { id: product.id },
    props: { product },
  }));
}

const { product } = Astro.props;
const { Content } = await render(product);
const {
  highlights,
  specGroups,
  variants,
  relatedProduct,
  viewer,
  onModule,
  onCarrier,
  frozen,
  open,
} = product.data;
const isKit = product.data.kind === "kit";
const defaultSku = variants?.[0];
const related = relatedProduct
  ? (await getCollection("products")).find((item) => item.id === relatedProduct)
  : undefined;
const primers = (await getCollection("blog"))
  .filter((post) => post.data.tags.includes("n6"))
  .sort((a, b) => (a.data.order ?? 99) - (b.data.order ?? 99));
const showPrimers = product.id === "dnl-n6" && primers.length > 0;
const pageDescription =
  product.id === "dnl-n6"
    ? "DNL-N6, an STM32N6 SoM for a carrier you design."
    : product.data.summary;
const specLead = isKit
  ? "Kit figures. Connectors and mechanics wait for the design release."
  : "Module figures. Silicon that still depends on the STM32N6 device waits for hardware freeze.";
---

<Layout title={product.data.title} description={pageDescription}>
  <article>
    <header>
      <div class="shell section">
        <p class="eyebrow">{product.data.category}</p>
        <h1 class="title mt-3">{product.data.title}</h1>
        <p class="mt-3 font-mono text-sm text-muted">{product.data.chip}</p>
        <p class="lead mt-4 max-w-3xl">{product.data.summary}</p>

        {
          variants && variants.length > 0 && (
            <div class="mt-8" data-sku-switch>
              <p class="font-mono text-[11px] uppercase tracking-[0.18em] text-muted">Order code</p>
              <div class="mt-3 flex flex-wrap gap-2" role="tablist" aria-label="SKU">
                {variants.map((sku, index) => (
                  <button
                    type="button"
                    class="sku-tab"
                    role="tab"
                    data-code={sku.code}
                    aria-selected={index === 0 ? "true" : "false"}
                  >
                    {sku.title}
                  </button>
                ))}
              </div>
              <p class="sku-code mt-3 font-mono text-sm text-accent-text" data-sku-code>
                {defaultSku?.code}
              </p>
            </div>
          )
        }

        <p class="mt-8 text-sm text-muted">Not for sale yet.</p>

        <div class="mt-6 flex flex-wrap gap-3">
          <a href="#interest" class="btn-primary">Register interest</a>
          {
            related && (
              <a href={`/products/${related.id}`} class="btn-secondary">
                {related.data.shortName}
              </a>
            )
          }
        </div>
      </div>
    </header>

    {
      viewer && (
        <section class="border-y border-divider" aria-label="CAD model">
          <div class="shell section-sm">
            <ProductViewer
              som={viewer.som}
              kit={viewer.kit}
              combined={viewer.combined}
              defaultMode={isKit ? "kit" : "som"}
            />
          </div>
        </section>
      )
    }

    {
      highlights && highlights.length > 0 && (
        <section aria-label="Key figures">
          <div class="shell">
            <div class:list={["facts-grid", isKit && "facts-grid-kit"]}>
              {highlights.map((item) => (
                <div class="facts-cell">
                  <p class="facts-value">{item.value}</p>
                  <p class="facts-label">{item.label}</p>
                </div>
              ))}
            </div>
          </div>
        </section>
      )
    }

    <div class="shell section space-y-12">
      {
        (frozen || open) && (
          <section>
            <h2 class="text-2xl font-medium tracking-tight md:text-3xl">Frozen and still open</h2>
            <div class="mt-6 grid gap-8 sm:grid-cols-2">
              {frozen && frozen.length > 0 && (
                <SpecTable title="Frozen" rows={frozen} />
              )}
              {open && open.length > 0 && (
                <SpecTable title="Still open" rows={open} />
              )}
            </div>
          </section>
        )
      }

      {
        (onModule || onCarrier) && (
          <section>
            <h2 class="text-2xl font-medium tracking-tight md:text-3xl">
              {isKit ? "On the kit vs on the SoM" : "SoM and carrier"}
            </h2>
            <div class="mt-6 grid gap-8 sm:grid-cols-2">
              {onModule && (
                <div>
                  <h3 class="font-medium tracking-tight">{isKit ? "On the SoM" : "On the module"}</h3>
                  <ul class="mt-4 space-y-2 text-sm leading-relaxed text-muted">
                    {onModule.map((item) => (
                      <li>{item}</li>
                    ))}
                  </ul>
                </div>
              )}
              {onCarrier && (
                <div>
                  <h3 class="font-medium tracking-tight">{isKit ? "On the kit" : "On your carrier"}</h3>
                  <ul class="mt-4 space-y-2 text-sm leading-relaxed text-muted">
                    {onCarrier.map((item) => (
                      <li>{item}</li>
                    ))}
                  </ul>
                </div>
              )}
            </div>
          </section>
        )
      }

      {
        product.id === "dnl-n6" && (
          <section id="block-diagram">
            <h2 class="text-2xl font-medium tracking-tight md:text-3xl">Block diagram</h2>
            <p class="mt-4 max-w-2xl text-sm leading-relaxed text-muted">
              Power and PHY on the module. MDI, CSI-2, and the rest of the I/O at the edge.
            </p>
            <div class="mt-8">
              <N6BlockDiagram />
            </div>
          </section>
        )
      }
    </div>

    {
      specGroups && specGroups.length > 0 && (
        <section id="specifications" class="border-t border-divider">
          <div class="shell section">
            <h2 class="text-2xl font-medium tracking-tight md:text-3xl">Specifications</h2>
            <p class="mt-4 max-w-2xl text-sm leading-relaxed text-muted">
              {specLead}
            </p>
            <div class="mt-8 grid gap-8 lg:grid-cols-2">
              {specGroups.map((group) => (
                <SpecTable title={group.title} rows={group.rows} />
              ))}
            </div>
          </div>
        </section>
      )
    }

    <div class="shell section">
      <div class="prose-lab max-w-3xl">
        <Content />
      </div>
    </div>

    {
      showPrimers && (
        <section>
          <div class="shell section pt-0">
            <ul class="grid gap-x-8 gap-y-3 sm:grid-cols-2">
              {primers.map((item) => (
                <li>
                  <a href={`/blog/${item.id}`} class="text-sm text-accent-text underline underline-offset-2">
                    {item.data.title}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        </section>
      )
    }

    <section id="interest" class="border-t border-divider">
      <div class="shell section">
        <div class="panel-raised max-w-xl">
          <div class="p-5 sm:p-6">
            <h2 class="text-xl font-medium tracking-tight">Register interest</h2>
            <p class="mt-2 text-sm text-muted">This is not an order.</p>
            <div class="mt-6">
              <ContactForm
                name="interest"
                variant="interest"
                product={product.data.shortName}
                skus={variants}
              />
            </div>
          </div>
        </div>
      </div>
    </section>
  </article>
</Layout>

{
  variants && variants.length > 0 && (
    <script>
      const root = document.querySelector("[data-sku-switch]");
      const tabs = root?.querySelectorAll<HTMLButtonElement>("[data-code]");
      const code = root?.querySelector("[data-sku-code]");

      tabs?.forEach((tab) => {
        tab.addEventListener("click", () => {
          const value = tab.dataset.code;
          if (!value) return;
          tabs.forEach((item) => item.setAttribute("aria-selected", String(item === tab)));
          if (code) code.textContent = value;
          window.dispatchEvent(new CustomEvent("dnl-sku", { detail: value }));
        });
      });
    </script>
  )
}
