---
import Layout from "@/layouts/Layout.astro";
import ContactForm from "@/components/ContactForm.astro";
import SpecTable from "@/components/SpecTable.astro";
import ProductViewer from "@/components/ProductViewer.astro";
import { getCollection } from "astro:content";

export async function getStaticPaths() {
  const products = await getCollection("products");
  return products.map((product) => ({
    params: { id: product.id },
    props: { product },
  }));
}

const { product } = Astro.props;
const {
  highlights,
  specGroups,
  variants,
  relatedProduct,
  viewer,
} = product.data;
const isKit = product.data.kind === "kit";
const compareLabels = ["MCU", "PSRAM", "NOR", "Input"];
const compareByCode: Record<string, string[]> = {
  "DNL-N6-P2x64-F128": [
    "STM32N657X0H3Q",
    "2×64 MB",
    "128 MB octal",
    "About 5–24 V",
  ],
  "DNL-N6-P1x64-F128": [
    "STM32N657X0H3Q",
    "1×64 MB",
    "128 MB octal",
    "About 5–24 V",
  ],
};
const compareSkus =
  variants &&
  variants.length > 1 &&
  variants.every((sku) => compareByCode[sku.code]?.length === compareLabels.length)
    ? variants
    : undefined;
const related = relatedProduct
  ? (await getCollection("products")).find((item) => item.id === relatedProduct)
  : undefined;
const primers = (await getCollection("blog"))
  .filter((post) => post.data.tags.includes("n6"))
  .sort((a, b) => (a.data.order ?? 99) - (b.data.order ?? 99));
const showPrimers = product.id === "dnl-n6" && primers.length > 0;
const pageDescription =
  product.id === "dnl-n6"
    ? "DNL-N6, an STM32N657X0 module for a carrier you design."
    : product.data.summary;
const specLead = isKit
  ? "Kit figures. Connectors and mechanics wait for the design release."
  : "Closed figures. The outline and the interconnect are not published yet.";
---

<Layout title={product.data.title} description={pageDescription}>
  <article>
    <header>
      <div class="shell section">
        <p class="eyebrow">{product.data.category}</p>
        <h1 class="title mt-3">{product.data.title}</h1>
        <p class="mt-3 font-mono text-sm text-muted">{product.data.chip}</p>
        <p class="lead mt-4 max-w-3xl">{product.data.summary}</p>

        {
          compareSkus && (
            <div class="compare mt-10" data-sku-switch>
              <table class="compare-table">
                <caption class="sr-only">Order codes</caption>
                <colgroup>
                  <col class="compare-figure" />
                  <col />
                  <col />
                </colgroup>
                <thead>
                  <tr>
                    <th scope="col">
                      <span class="sr-only">Figure</span>
                    </th>
                    {compareSkus.map((sku, index) => (
                      <th scope="col">
                        <button
                          type="button"
                          class="compare-pick"
                          data-code={sku.code}
                          aria-pressed={index === 0 ? "true" : "false"}
                        >
                          <span class="compare-code">{sku.code}</span>
                          <span class="compare-note">{index === 0 ? "Default" : ""}</span>
                        </button>
                      </th>
                    ))}
                  </tr>
                </thead>
                <tbody>
                  {compareLabels.map((label, row) => (
                    <tr>
                      <th scope="row">{label}</th>
                      {compareSkus.map((sku) => (
                        <td>
                          {label === "MCU" ? (
                            <>
                              STM32<wbr />N657X0H3Q
                            </>
                          ) : (
                            compareByCode[sku.code][row]
                          )}
                        </td>
                      ))}
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          )
        }

        <p class="mt-8 text-sm text-muted">Not for sale yet.</p>

        <div class="mt-6 flex flex-wrap gap-3">
          <a href="#interest" class="btn-primary">Register interest</a>
          {
            related && (
              <a href={`/products/${related.id}`} class="btn-secondary">
                {related.data.shortName}
              </a>
            )
          }
        </div>
      </div>
    </header>

    {
      viewer && (
        <section class="border-y border-divider" aria-label="CAD model">
          <div class="shell section-sm">
            <ProductViewer
              som={viewer.som}
              kit={viewer.kit}
              combined={viewer.combined}
              defaultMode={isKit ? "kit" : "som"}
            />
          </div>
        </section>
      )
    }

    {
      !compareSkus && highlights && highlights.length > 0 && (
        <section aria-label="Key figures">
          <div class="shell">
            <div class:list={["facts-grid", isKit && "facts-grid-kit"]}>
              {highlights.map((item) => (
                <div class="facts-cell">
                  <p class="facts-value">{item.value}</p>
                  <p class="facts-label">{item.label}</p>
                </div>
              ))}
            </div>
          </div>
        </section>
      )
    }

    {
      specGroups && specGroups.length > 0 && (
        <section id="specifications" class="border-t border-divider">
          <div class="shell section">
            <h2 class="text-2xl font-medium tracking-tight md:text-3xl">Specifications</h2>
            <p class="mt-4 max-w-2xl text-sm leading-relaxed text-muted">
              {specLead}
            </p>
            <div class="mt-8">
              <SpecTable groups={specGroups} />
            </div>
          </div>
        </section>
      )
    }

    {
      showPrimers && (
        <section>
          <div class="shell section pt-0">
            <ul class="grid gap-x-8 gap-y-3 sm:grid-cols-2">
              {primers.map((item) => (
                <li>
                  <a href={`/blog/${item.id}`} class="text-sm text-accent-text underline underline-offset-2">
                    {item.data.title}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        </section>
      )
    }

    <section id="interest" class="border-t border-divider">
      <div class="shell section">
        <div class="panel-raised max-w-xl">
          <div class="p-5 sm:p-6">
            <h2 class="text-xl font-medium tracking-tight">Register interest</h2>
            <p class="mt-2 text-sm text-muted">This is not an order.</p>
            <div class="mt-6">
              <ContactForm
                name="interest"
                variant="interest"
                product={product.data.shortName}
                skus={variants}
              />
            </div>
          </div>
        </div>
      </div>
    </section>
  </article>
</Layout>

{
  variants && variants.length > 0 && (
    <script>
      const root = document.querySelector("[data-sku-switch]");
      const picks = root?.querySelectorAll<HTMLButtonElement>(".compare-pick");

      picks?.forEach((pick) => {
        pick.addEventListener("click", () => {
          const value = pick.dataset.code;
          if (!value) return;
          picks.forEach((item) => item.setAttribute("aria-pressed", String(item === pick)));
          window.dispatchEvent(new CustomEvent("dnl-sku", { detail: value }));
        });
      });
    </script>
  )
}
