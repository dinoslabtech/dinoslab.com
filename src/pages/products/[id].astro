---
import Layout from "@/layouts/Layout.astro";
import ContactForm from "@/components/ContactForm.astro";
import SpecTable from "@/components/SpecTable.astro";
import ModuleDiagram from "@/components/ModuleDiagram.astro";
import { productStatusLabel } from "@/data/site";
import { createTermLinker } from "@/data/terms";
import { getCollection, render } from "astro:content";

export async function getStaticPaths() {
  const products = await getCollection("products");
  return products.map((product) => ({
    params: { id: product.id },
    props: { product },
  }));
}

const { product } = Astro.props;
const { Content } = await render(product);
const { highlights, features, specGroups } = product.data;
const link = createTermLinker();
const primers = (await getCollection("blog"))
  .filter((post) => post.data.tags.includes("n6"))
  .sort((a, b) => (a.data.order ?? 99) - (b.data.order ?? 99));

const diagram = [
  {
    kicker: "Camera",
    title: "MIPI CSI-2",
    body: "2-lane serial camera plus 16-bit PSSI. On-chip ISP, three pipes.",
  },
  {
    kicker: "MCU",
    title: "STM32N6 series",
    body: "Cortex-M55 at 800 MHz, Neural-ART 600 GOPS, NeoChrom GPU, H.264, 4.2 MB SRAM.",
  },
  {
    kicker: "XSPI ×16",
    title: "AP Memory HexaSPI",
    body: "APS256XXN, 256 Mbit PSRAM, 1.8 V. Framebuffers and activations.",
  },
  {
    kicker: "XSPI ×8",
    title: "Octo-SPI NOR",
    body: "512 Mbit, 1.8 V, 200 MHz DTR. FSBL, application, and network weights.",
  },
];

const statusLabel = productStatusLabel[product.data.status];
---

<Layout title={product.data.title} description={product.data.summary}>
  <article>
    <header>
      <div class="shell py-16 lg:py-20">
        <p class="eyebrow">{product.data.category}</p>
        <div class="mt-3 flex flex-wrap items-center gap-3">
          <h1 class="display">{product.data.title}</h1>
          <span class="badge">{statusLabel}</span>
        </div>
        <p class="mt-3 font-mono text-sm text-muted">{product.data.chip}</p>
        <p class="lead mt-6 max-w-3xl" set:html={link(product.data.summary)} />
        <div class="mt-8 flex flex-wrap gap-3">
          <a href="#interest" class="btn-primary">Register interest</a>
          <a href="#specifications" class="btn-secondary">Specifications</a>
        </div>
      </div>
    </header>

    {
      highlights && highlights.length > 0 && (
        <section aria-label="Key figures">
          <div class="shell">
            <div class="facts-grid">
              {
                highlights.map((item) => (
                  <div class="facts-cell">
                    <p class="facts-value" set:html={item.value} />
                    <p class="facts-label" set:html={link(item.label)} />
                  </div>
                ))
              }
            </div>
          </div>
        </section>
      )
    }

    <div class="shell grid gap-12 py-16 lg:grid-cols-12 lg:py-20">
      <div class="lg:col-span-8">
        {
          features && features.length > 0 && (
            <section id="features">
              <h2 class="text-3xl font-medium tracking-tight">What is on the board</h2>
              <div class="mt-10 grid gap-6 sm:grid-cols-2">
                {features.map((item) => (
                  <div class="panel p-5 sm:p-6">
                    <h3 class="font-medium tracking-tight">{item.title}</h3>
                    <p class="mt-3 text-sm leading-relaxed text-muted" set:html={link(item.body)} />
                  </div>
                ))}
              </div>
            </section>
          )
        }

        {
          product.id === "dnl-n6" && (
            <section id="block-diagram" class="mt-16">
              <h2 class="text-3xl font-medium tracking-tight">Block diagram</h2>
              <p class="mt-4 max-w-2xl text-sm leading-relaxed text-muted">
                Camera in, Neural-ART and the M55 in the middle, two XSPI memories on the
                side. Carrier I/O is not frozen; the silicon and the two memories are.
              </p>
              <div class="mt-8">
                <ModuleDiagram nodes={diagram} link={link} />
              </div>
            </section>
          )
        }
      </div>

      <aside class="h-fit lg:col-span-4 lg:sticky lg:top-24" id="interest">
        <div class="panel">
          <div class="border-b border-line px-5 py-3">
            <p class="font-mono text-[11px] uppercase tracking-[0.18em] text-muted">
              Interest · {product.data.shortName}
            </p>
          </div>
          <div class="p-5 sm:p-6">
            <p class="text-sm text-muted">
              An evaluation sample to test the module, or a quantity to buy. No
              payment.
            </p>
            <div class="mt-6">
              <ContactForm
                name="interest"
                variant="interest"
                product={product.data.shortName}
              />
            </div>
          </div>
        </div>
      </aside>
    </div>

    {
      specGroups && specGroups.length > 0 && (
        <section id="specifications" class="border-t border-line bg-panel">
          <div class="shell py-16 lg:py-20">
            <h2 class="text-3xl font-medium tracking-tight">Specifications</h2>
            <p class="mt-4 max-w-2xl text-sm leading-relaxed text-muted">
              MCU figures from the STM32N6 series (ST DS14791). The exact device —
              package, temperature grade, crypto — is chosen at hardware freeze.
              Module mechanics are not final.
            </p>
            <div class="mt-12 grid gap-10 lg:grid-cols-2">
              {specGroups.map((group) => (
                <SpecTable title={group.title} rows={group.rows} link={link} />
              ))}
            </div>
          </div>
        </section>
      )
    }

    <div class="shell py-16 lg:py-20">
      <div class="prose-lab max-w-3xl">
        <Content />
      </div>
    </div>

    {
      product.id === "dnl-n6" && primers.length > 0 && (
        <section class="border-t border-line bg-panel">
          <div class="shell py-16 lg:py-20">
            <h2 class="text-3xl font-medium tracking-tight">Related articles</h2>
            <p class="mt-4 max-w-2xl text-sm leading-relaxed text-muted">
              Short articles on the buses, package, and memories named above. Linked
              in place where those words first appear.
            </p>
            <ul class="mt-10 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
              {primers.map((item) => (
                <li>
                  <a href={`/blog/${item.id}`} class="panel block h-full p-5 transition-colors hover:border-lab">
                    <p class="font-medium tracking-tight">{item.data.title}</p>
                    <p class="mt-2 text-sm leading-relaxed text-muted">{item.data.description}</p>
                  </a>
                </li>
              ))}
            </ul>
          </div>
        </section>
      )
    }
  </article>
</Layout>
