---
import Layout from "@/layouts/Layout.astro";
import PageIntro from "@/components/PageIntro.astro";
import ProductCard from "@/components/ProductCard.astro";
import { getCollection } from "astro:content";

const products = await getCollection("products");
---

<Layout
  title="Products"
  description="The first Dino’s Lab module is an STM32N6 board for edge AI. Leave a note if you might want some."
>
  <div class="shell py-16 lg:py-20">
    <PageIntro kicker="Products" title="What’s in the works">
      Nothing for sale yet. First up is an STM32N6 module. If that sounds
      useful, say how many you might want.
    </PageIntro>

    <div
      class:list={[
        "mt-12 grid gap-6",
        products.length > 1 ? "md:grid-cols-2" : "max-w-xl",
      ]}
    >
      {
        products.map((product) => (
          <ProductCard
            href={`/products/${product.id}`}
            category={product.data.category}
            title={product.data.title}
            chip={product.data.chip}
            summary={product.data.summary}
          />
        ))
      }
    </div>
  </div>
</Layout>
