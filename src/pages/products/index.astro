---
import Layout from "@/layouts/Layout.astro";
import ModuleRow from "@/components/ModuleRow.astro";
import { getCollection } from "astro:content";

const products = (await getCollection("products")).filter((product) => product.data.kind === "som");
---

<Layout title="Products" description="DNL-N6, an STM32N657X0 module.">
  <div class="shell section">
    <h1 class="title">Products</h1>
    <div class="mt-8">
      {products.map((product) => <ModuleRow product={product} />)}
    </div>
  </div>
</Layout>
