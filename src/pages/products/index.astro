---
import Layout from "@/layouts/Layout.astro";
---

<Layout title="Products" description="DNL-N6 and the DNL-N6 DevKit.">
  <div class="shell section">
    <h1 class="title">Products</h1>
    <ul class="mt-8 divide-y divide-divider border-y border-divider">
      <li>
        <a href="/products/dnl-n6" class="group block py-8">
          <h2 class="text-xl font-medium tracking-tight group-hover:text-accent-text">DNL-N6</h2>
          <p class="mt-2 text-sm text-muted">STM32N6 SoM.</p>
        </a>
      </li>
      <li>
        <a href="/products/dnl-n6-dk" class="group block py-8">
          <h2 class="text-xl font-medium tracking-tight group-hover:text-accent-text">DNL-N6 DevKit</h2>
          <p class="mt-2 text-sm text-muted">Eval carrier for the DNL-N6.</p>
        </a>
      </li>
    </ul>
  </div>
</Layout>
