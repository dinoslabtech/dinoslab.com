---
import Layout from "@/layouts/Layout.astro";
import ContactForm from "@/components/ContactForm.astro";
import ProductCard from "@/components/ProductCard.astro";
import { site } from "@/data/site";
import { getCollection } from "astro:content";

const products = await getCollection("products");
---

<Layout>
  <section class="border-b border-line">
    <div class="shell grid items-center gap-12 py-16 lg:grid-cols-12 lg:gap-10 lg:py-24">
      <div class="lg:col-span-7">
        <p class="eyebrow">Hardware studio · {site.location}</p>
        <h1 class="display mt-4 max-w-xl">
          Boards and modules, designed in the lab.
        </h1>
        <p class="lead mt-6">
          Dino’s Lab is an independent studio. We design PCBs, write the firmware
          and software that sit on them, and assemble in Italy — from a handful
          of prototypes to tens of thousands a month.
        </p>
        <div class="mt-8 flex flex-wrap gap-3">
          <a href="/products" class="btn-primary">First module</a>
          <a href="/consulting" class="btn-secondary">Custom boards</a>
        </div>
      </div>

      <figure class="panel lg:col-span-5">
        <figcaption class="flex items-center justify-between border-b border-line px-4 py-2 font-mono text-[10px] uppercase tracking-[0.18em] text-muted">
          <span>Fig. 01</span>
          <span>DNL-MARK</span>
        </figcaption>
        <div class="figure-grid px-8 py-10">
          <img
            src="/logo.svg"
            alt="Dino’s Lab mark: a sauropod with PCB traces along its back"
            class="mx-auto w-full max-w-sm"
          />
        </div>
      </figure>
    </div>
  </section>

  <section class="border-b border-line bg-white">
    <div class="shell grid grid-cols-1 divide-y divide-line sm:grid-cols-3 sm:divide-x sm:divide-y-0">
      <div class="py-8 sm:pr-8">
        <p class="font-mono text-[11px] uppercase tracking-[0.18em] text-lab">01</p>
        <h2 class="mt-3 text-lg font-medium tracking-tight">Custom work</h2>
        <p class="mt-2 text-sm leading-relaxed text-muted">
          Schematic, layout, firmware, and software around the board. Prototypes
          first, then a small series or a production run.
        </p>
        <a href="/consulting" class="mt-4 inline-block font-mono text-[11px] uppercase tracking-[0.16em] text-lab hover:underline">
          Consulting <span aria-hidden="true" class="font-sans">→</span>
        </a>
      </div>
      <div class="py-8 sm:px-8">
        <p class="font-mono text-[11px] uppercase tracking-[0.18em] text-lab">02</p>
        <h2 class="mt-3 text-lg font-medium tracking-tight">Assembled in Italy</h2>
        <p class="mt-2 text-sm leading-relaxed text-muted">
          Production agreement with{" "}
          <a class="text-ink underline decoration-line underline-offset-2 hover:text-lab" href={site.acme.url}>
            {site.acme.name}
          </a>
          {" "}in Ladispoli. Pick-and-place and vapour-phase — the same line as their RoadRunner SOM.
        </p>
      </div>
      <div class="py-8 sm:pl-8">
        <p class="font-mono text-[11px] uppercase tracking-[0.18em] text-lab">03</p>
        <h2 class="mt-3 text-lg font-medium tracking-tight">Worldwide</h2>
        <p class="mt-2 text-sm leading-relaxed text-muted">
          Based in the Rome area. The studio works in English and takes projects from anywhere.
        </p>
      </div>
    </div>
  </section>

  <section class="border-b border-line">
    <div class="shell py-16 lg:py-20">
      <div class="flex flex-wrap items-end justify-between gap-4">
        <div>
          <p class="eyebrow">Catalog</p>
          <h2 class="mt-3 text-3xl font-medium tracking-tight">In the lab</h2>
        </div>
        <p class="max-w-md text-sm leading-relaxed text-muted">
          The catalog is just starting. Register interest if you want a board —
          even if you only want to try one.
        </p>
      </div>
      <div
        class:list={[
          "mt-10 grid gap-6",
          products.length > 1 ? "md:grid-cols-2" : "max-w-xl",
        ]}
      >
        {
          products.map((product) => (
            <ProductCard
              href={`/products/${product.id}`}
              category={product.data.category}
              title={product.data.title}
              chip={product.data.chip}
              summary={product.data.summary}
              heading="h3"
            />
          ))
        }
      </div>
    </div>
  </section>

  <section>
    <div class="shell grid gap-12 py-16 lg:grid-cols-12 lg:py-20">
      <div class="lg:col-span-5">
        <p class="eyebrow">Contact</p>
        <h2 class="mt-3 text-3xl font-medium tracking-tight">Tell us what you need</h2>
        <p class="mt-4 text-sm leading-relaxed text-muted">
          A quote for a custom board, or a note that you want the N6 module when
          it exists. Email, SIM, or Telegram — or the form.
        </p>
        <dl class="mt-8 divide-y divide-line border-y border-line text-sm">
          <div class="flex justify-between gap-4 py-3">
            <dt class="font-mono text-[11px] uppercase tracking-[0.16em] text-muted">Email</dt>
            <dd>
              <a class="hover:text-lab" href={`mailto:${site.email}`}>{site.email}</a>
            </dd>
          </div>
          <div class="flex justify-between gap-4 py-3">
            <dt class="font-mono text-[11px] uppercase tracking-[0.16em] text-muted">SIM</dt>
            <dd>
              <a class="hover:text-lab" href={`tel:${site.phone.replace(/\s/g, "")}`}>{site.phone}</a>
            </dd>
          </div>
          <div class="flex justify-between gap-4 py-3">
            <dt class="font-mono text-[11px] uppercase tracking-[0.16em] text-muted">Telegram</dt>
            <dd>
              <a class="hover:text-lab" href={site.telegram}>{site.telegramHandle}</a>
            </dd>
          </div>
        </dl>
      </div>
      <div class="panel p-6 sm:p-8 lg:col-span-7">
        <p class="font-mono text-[11px] uppercase tracking-[0.18em] text-muted">Message</p>
        <div class="mt-5">
          <ContactForm />
        </div>
      </div>
    </div>
  </section>
</Layout>
