---
import Layout from "@/layouts/Layout.astro";
import ContactForm from "@/components/ContactForm.astro";
import ContactLinks from "@/components/ContactLinks.astro";
import ProductCard from "@/components/ProductCard.astro";
import { getCollection } from "astro:content";

const products = await getCollection("products");
---

<Layout>
  <section class="border-b border-line">
    <div class="shell grid items-center gap-10 py-12 sm:py-16 lg:grid-cols-12 lg:gap-10 lg:py-24">
      <div class="lg:col-span-7">
        <p class="eyebrow">Catalogue</p>
        <h1 class="display mt-4 max-w-xl">PCB boards, modules, electronics.</h1>
        <p class="lead mt-6">
          Dino’s Lab designs and sells circuit boards and electronics modules.
          First release is an STM32N6 board for edge AI and vision.
        </p>
        <div class="mt-8 flex flex-wrap gap-3">
          <a href="/products" class="btn-primary">Products</a>
          <a href="/products/dnl-n6" class="btn-secondary">DNL-N6</a>
        </div>
      </div>

      <figure class="panel lg:col-span-5">
        <div class="figure-grid px-8 py-10">
          <img
            src="/logo.svg"
            alt="Dino’s Lab mark: a sauropod with PCB traces along its back"
            class="mx-auto w-full max-w-sm"
          />
        </div>
      </figure>
    </div>
  </section>

  <section class="border-b border-line">
    <div class="shell py-12 sm:py-16 lg:py-20">
      <div class="flex flex-col gap-4 md:flex-row md:items-end md:justify-between">
        <div>
          <p class="eyebrow">Products</p>
          <h2 class="mt-3 text-3xl font-medium tracking-tight">In the catalogue</h2>
        </div>
        <p class="max-w-md text-sm leading-relaxed text-muted">
          The DNL-N6 is the first board. Register interest, including indicative
          quantity. Further boards will follow.
        </p>
      </div>
      <div
        class:list={[
          "mt-10 grid gap-6",
          products.length > 1 ? "md:grid-cols-2" : "",
        ]}
      >
        {
          products.map((product) => (
            <ProductCard
              href={`/products/${product.id}`}
              category={product.data.category}
              title={product.data.title}
              chip={product.data.chip}
              summary={product.data.summary}
              heading="h3"
              featured={products.length === 1}
            />
          ))
        }
      </div>
    </div>
  </section>

  <section class="border-b border-line">
    <div class="shell grid gap-10 py-12 sm:gap-12 sm:py-16 lg:grid-cols-12 lg:py-20">
      <div class="lg:col-span-5">
        <p class="eyebrow">Contact</p>
        <h2 class="mt-3 text-3xl font-medium tracking-tight">Product enquiry</h2>
        <p class="mt-4 text-sm leading-relaxed text-muted">
          A board in the catalogue, a sample, or the N6 waitlist.
        </p>
        <div class="mt-8">
          <ContactLinks />
        </div>
      </div>
      <div class="panel p-6 sm:p-8 lg:col-span-7">
        <p class="text-sm font-medium">Message</p>
        <div class="mt-5">
          <ContactForm />
        </div>
      </div>
    </div>
  </section>

  <section class="bg-panel">
    <div class="shell flex flex-col gap-4 py-8 sm:flex-row sm:items-center sm:justify-between sm:py-10">
      <div>
        <p class="eyebrow">Custom work</p>
        <p class="mt-2 text-lg font-medium tracking-tight">A board that is not in the catalogue.</p>
        <p class="mt-1 max-w-xl text-sm leading-relaxed text-muted">
          Schematic, layout, firmware, and assembly on request.
        </p>
      </div>
      <a href="/consulting" class="btn-secondary shrink-0">Consulting</a>
    </div>
  </section>
</Layout>
