---
import Layout from "@/layouts/Layout.astro";
import { site } from "@/data/site";
---

<Layout description="DNL-N6, an STM32N6 SoM. Dino's Lab, Ladispoli.">
  <section class="border-b border-divider">
    <div class="shell section-hero grid items-center gap-8 lg:grid-cols-12 lg:gap-10">
      <div class="lg:col-span-7">
        <h1 class="display-hero hero-title">
          <span class="sr-only">{site.name}</span>
          <img src="/wordmark.svg" alt="" class="hero-wordmark" />
        </h1>
        <p class="mt-6 max-w-2xl text-lg leading-relaxed text-muted">
          Solder-down modules, designed in Ladispoli, built by Acme Systems.
          <br />
          First board: DNL-N6.
        </p>
      </div>
      <figure class="panel overflow-hidden lg:col-span-5">
        <div class="figure-grid px-8 py-10">
          <img
            src="/mark.svg"
            alt="Dino’s Lab mark: a sauropod with PCB traces along its back"
            class="hero-mark"
          />
        </div>
      </figure>
    </div>
  </section>

  <section>
    <div class="shell">
      <a href="/products/dnl-n6" class="group block py-8">
        <h2 class="text-xl font-medium tracking-tight group-hover:text-accent-text">DNL-N6</h2>
      </a>
    </div>
  </section>
</Layout>
