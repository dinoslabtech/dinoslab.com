---
import Layout from "@/layouts/Layout.astro";
import ProductCard from "@/components/ProductCard.astro";
import { productStatusLabel } from "@/data/site";
import { getCollection } from "astro:content";

const products = await getCollection("products");
const comingSoon = products.filter((product) => product.data.status === "coming_soon");
const available = products.filter((product) => product.data.status === "available");
---

<Layout>
  <section class="border-b border-line">
    <div class="shell section-hero grid items-center gap-8 lg:grid-cols-12 lg:gap-10">
      <div class="lg:col-span-7">
        <h1 class="display max-w-xl">PCB boards, modules, electronics.</h1>
        <p class="lead mt-4">
          Dino’s Lab designs and sells circuit boards and electronics modules.
          First release is an STM32N6 module for edge AI and vision.
        </p>
        <div class="mt-8 flex flex-wrap gap-3">
          <a href="/products" class="btn-primary">Products</a>
          <a href="/products/dnl-n6" class="btn-secondary">DNL-N6</a>
        </div>
      </div>

      <figure class="panel overflow-hidden lg:col-span-5">
        <div class="figure-grid px-8 py-10">
          <img
            src="/logo.svg"
            alt="Dino’s Lab mark: a sauropod with PCB traces along its back"
            class="mx-auto w-full max-w-sm"
          />
        </div>
      </figure>
    </div>
  </section>

  {
    comingSoon.length > 0 && (
      <section class="border-b border-line">
        <div class="shell section">
          <div class="flex flex-col gap-3 md:flex-row md:items-end md:justify-between md:gap-8">
            <h2 class="text-3xl font-medium tracking-tight">Coming soon</h2>
            <p class="max-w-md text-sm leading-relaxed text-muted">
              Boards in design. Register interest on the product page — an
              evaluation sample, or a quantity to buy.
            </p>
          </div>

          <div class="mt-8 grid gap-8">
            {comingSoon.map((product) => {
              const href = `/products/${product.id}`;
              const facts = product.data.highlights?.slice(0, 4) ?? [];
              return (
                <article class="panel overflow-hidden">
                  <div class="grid lg:grid-cols-12">
                    <div class="figure-grid flex min-h-48 items-center justify-center px-8 py-12 lg:col-span-5 lg:min-h-[22rem]">
                      <h3 class="font-mono text-3xl tracking-tight text-lab sm:text-4xl">
                        {product.data.title}
                      </h3>
                    </div>
                    <div class="flex flex-col lg:col-span-7">
                      <div class="flex flex-wrap items-center justify-between gap-2 border-b border-line px-5 py-2.5 sm:px-6">
                        <span class="font-mono text-[11px] uppercase tracking-[0.18em] text-lab">
                          {product.data.category}
                        </span>
                        <span class="badge">{productStatusLabel[product.data.status]}</span>
                      </div>
                      <div class="flex flex-1 flex-col px-5 py-6 sm:px-6 sm:py-8">
                        <p class="font-mono text-xs text-muted">{product.data.chip}</p>
                        <p class="mt-4 text-sm leading-relaxed text-muted">{product.data.summary}</p>
                        {facts.length > 0 && (
                          <div class="spotlight-facts mt-6">
                            {facts.map((item) => (
                              <div class="spotlight-cell">
                                <p class="facts-value text-lg">{item.value}</p>
                                <p class="facts-label">{item.label}</p>
                              </div>
                            ))}
                          </div>
                        )}
                        <div class="mt-8 flex flex-wrap gap-3">
                          <a href={href} class="btn-primary">
                            View {product.data.shortName}
                          </a>
                          <a href={`${href}#interest`} class="btn-secondary">
                            Register interest
                          </a>
                        </div>
                      </div>
                    </div>
                  </div>
                </article>
              );
            })}
          </div>
        </div>
      </section>
    )
  }

  {
    available.length > 0 && (
      <section class="border-b border-line">
        <div class="shell section">
          <h2 class="text-3xl font-medium tracking-tight">Available now</h2>
          <div
            class:list={[
              "mt-8 grid gap-6",
              available.length > 1 ? "md:grid-cols-2" : "",
            ]}
          >
            {available.map((product) => (
              <ProductCard
                href={`/products/${product.id}`}
                category={product.data.category}
                title={product.data.title}
                chip={product.data.chip}
                summary={product.data.summary}
                status={product.data.status}
                heading="h3"
              />
            ))}
          </div>
        </div>
      </section>
    )
  }

  <section class="bg-raised">
    <div class="shell section-sm flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
      <div>
        <p class="text-lg font-medium tracking-tight">Custom work</p>
        <p class="mt-1 max-w-xl text-sm leading-relaxed text-muted">
          Schematic, layout, firmware, and assembly on request.
        </p>
      </div>
      <a href="/consulting" class="btn-secondary shrink-0">Consulting</a>
    </div>
  </section>
</Layout>
