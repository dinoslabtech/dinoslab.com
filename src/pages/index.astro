---
import Layout from "@/layouts/Layout.astro";
import ContactForm from "@/components/ContactForm.astro";
import ContactLinks from "@/components/ContactLinks.astro";
import ProductCard from "@/components/ProductCard.astro";
import { site } from "@/data/site";
import { getCollection } from "astro:content";

const products = await getCollection("products");
---

<Layout>
  <section class="border-b border-line">
    <div class="shell grid items-center gap-10 py-12 sm:py-16 lg:grid-cols-12 lg:gap-10 lg:py-24">
      <div class="lg:col-span-7">
        <p class="eyebrow">{site.location}</p>
        <h1 class="display mt-4 max-w-xl">We design and build electronics.</h1>
        <p class="lead mt-6">
          Dino’s Lab is a small studio in Ladispoli, just outside Rome. PCB
          layout, firmware, and the software around the board. Assembly stays
          in Italy — a handful of prototypes, or a real production run.
        </p>
        <div class="mt-8 flex flex-wrap gap-3">
          <a href="/products" class="btn-primary">N6 module</a>
          <a href="/consulting" class="btn-secondary">Custom boards</a>
        </div>
      </div>

      <figure class="panel lg:col-span-5">
        <div class="figure-grid px-8 py-10">
          <img
            src="/logo.svg"
            alt="Dino’s Lab mark: a sauropod with PCB traces along its back"
            class="mx-auto w-full max-w-sm"
          />
        </div>
      </figure>
    </div>
  </section>

  <section class="border-b border-line bg-panel">
    <div class="shell grid grid-cols-1 divide-y divide-line md:grid-cols-3 md:divide-x md:divide-y-0">
      <div class="py-8 md:pr-8">
        <h2 class="text-lg font-medium tracking-tight">Custom boards</h2>
        <p class="mt-2 text-sm leading-relaxed text-muted">
          Schematic, layout, firmware, and a first run you can plug in. If the
          board doesn’t exist yet, that’s the work.
        </p>
        <a href="/consulting" class="mt-4 inline-flex min-h-11 items-center text-sm text-lab hover:underline">
          How a project runs&nbsp;→
        </a>
      </div>
      <div class="py-8 md:px-8">
        <h2 class="text-lg font-medium tracking-tight">Assembled in Italy</h2>
        <p class="mt-2 text-sm leading-relaxed text-muted">
          We build at{" "}
          <a class="text-ink underline decoration-line underline-offset-2 hover:text-lab" href={site.acme.url}>
            {site.acme.name}
          </a>
          {" "}in Ladispoli — pick-and-place and vapour-phase, the same line as
          their RoadRunner modules.
        </p>
      </div>
      <div class="py-8 md:pl-8">
        <h2 class="text-lg font-medium tracking-tight">English, anywhere</h2>
        <p class="mt-2 text-sm leading-relaxed text-muted">
          The studio is near Rome. The work can come from anywhere. We work in
          English.
        </p>
      </div>
    </div>
  </section>

  <section class="border-b border-line">
    <div class="shell py-12 sm:py-16 lg:py-20">
      <div class="flex flex-col gap-4 md:flex-row md:items-end md:justify-between">
        <div>
          <p class="eyebrow">Products</p>
          <h2 class="mt-3 text-3xl font-medium tracking-tight">First board</h2>
        </div>
        <p class="max-w-md text-sm leading-relaxed text-muted">
          We’re designing an STM32N6 module. If you might want some, leave a
          note — even for two or three.
        </p>
      </div>
      <div
        class:list={[
          "mt-10 grid gap-6",
          products.length > 1 ? "md:grid-cols-2" : "max-w-xl",
        ]}
      >
        {
          products.map((product) => (
            <ProductCard
              href={`/products/${product.id}`}
              category={product.data.category}
              title={product.data.title}
              chip={product.data.chip}
              summary={product.data.summary}
              heading="h3"
            />
          ))
        }
      </div>
    </div>
  </section>

  <section>
    <div class="shell grid gap-10 py-12 sm:gap-12 sm:py-16 lg:grid-cols-12 lg:py-20">
      <div class="lg:col-span-5">
        <p class="eyebrow">Contact</p>
        <h2 class="mt-3 text-3xl font-medium tracking-tight">Write to us</h2>
        <p class="mt-4 text-sm leading-relaxed text-muted">
          A quote, a question about the N6, or anything else. Email, phone, or
          Telegram.
        </p>
        <div class="mt-8">
          <ContactLinks />
        </div>
      </div>
      <div class="panel p-6 sm:p-8 lg:col-span-7">
        <p class="text-sm font-medium">Message</p>
        <div class="mt-5">
          <ContactForm />
        </div>
      </div>
    </div>
  </section>
</Layout>
