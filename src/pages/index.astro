---
import { existsSync } from "node:fs";
import { join } from "node:path";
import Layout from "@/layouts/Layout.astro";
import ProductCard from "@/components/ProductCard.astro";
import ProductViewer from "@/components/ProductViewer.astro";
import { site } from "@/data/site";
import { getCollection } from "astro:content";

const products = await getCollection("products");
const n6 = products.find((product) => product.id === "dnl-n6");
const kit = products.find((product) => product.id === "dnl-n6-dk");
const others = products.filter((product) => product.id !== "dnl-n6" && product.id !== "dnl-n6-dk");
const somSrc = n6?.data.viewer?.som;
const homeSomReady = Boolean(
  somSrc && existsSync(join(process.cwd(), "public", somSrc.replace(/^\//, ""))),
);
---

<Layout>
  <section class="border-b border-line">
    <div class="shell section-hero grid items-center gap-8 lg:grid-cols-12 lg:gap-10">
      <div class="lg:col-span-7">
        <h1 class="display-hero">{site.name}</h1>
        <p class="mt-6 max-w-2xl text-lg leading-relaxed text-muted">
          Solder-down modules, designed in Ladispoli, built by Acme Systems.
          <br />
          First board: DNL-N6.
        </p>
      </div>
      <figure class="panel overflow-hidden lg:col-span-5">
        <div class="figure-grid px-8 py-10">
          <img
            src="/logo.svg"
            alt="Dino’s Lab mark: a sauropod with PCB traces along its back"
            class="mx-auto w-full max-w-sm"
          />
        </div>
      </figure>
    </div>
  </section>

  {
    n6 && (
      <section class="border-b border-line">
        <div class="shell section">
          <div class="flex flex-col gap-3 md:flex-row md:items-end md:justify-between md:gap-8">
            <div>
              <p class="eyebrow">{n6.data.category}</p>
              <h2 class="display mt-3">{n6.data.title}</h2>
            </div>
            <p class="max-w-md text-sm leading-relaxed text-muted">{n6.data.summary}</p>
          </div>

          {
            homeSomReady && n6.data.viewer && (
              <div class="mt-10">
                <ProductViewer
                  som={n6.data.viewer.som}
                  kit={n6.data.viewer.kit}
                  combined={n6.data.viewer.combined}
                  layout="home"
                />
                <p class="mt-3">
                  <a href="/products/dnl-n6" class="text-sm text-lab hover:text-lab-bright">
                    Inspect in 3D
                  </a>
                </p>
              </div>
            )
          }

          {
            n6.data.highlights && (
              <div class="facts-grid mt-10">
                {n6.data.highlights.map((item) => (
                  <div class="facts-cell">
                    <p class="facts-value">{item.value}</p>
                    <p class="facts-label">{item.label}</p>
                  </div>
                ))}
              </div>
            )
          }

          <div class="mt-10 flex flex-wrap gap-3">
            <a href="/products/dnl-n6" class="btn-primary">
              View {n6.data.shortName}
            </a>
            <a href="/products/dnl-n6#interest" class="btn-secondary">
              Register interest
            </a>
          </div>
        </div>
      </section>
    )
  }

  {
    kit && (
      <section class="border-b border-line">
        <div class="shell section-sm flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
          <div>
            <p class="text-lg font-medium tracking-tight">{kit.data.title}</p>
            <p class="mt-1 max-w-xl text-sm leading-relaxed text-muted">{kit.data.summary}</p>
          </div>
          <a href={`/products/${kit.id}`} class="btn-secondary shrink-0">
            DevKit
          </a>
        </div>
      </section>
    )
  }

  {
    others.length > 0 && (
      <section>
        <div class="shell section">
          <h2 class="text-3xl font-medium tracking-tight">Also</h2>
          <div class="mt-8 grid gap-6 md:grid-cols-2">
            {others.map((product) => (
              <ProductCard
                href={`/products/${product.id}`}
                category={product.data.category}
                title={product.data.title}
                chip={product.data.chip}
                summary={product.data.summary}
                status={product.data.status}
                heading="h3"
              />
            ))}
          </div>
        </div>
      </section>
    )
  }
</Layout>
