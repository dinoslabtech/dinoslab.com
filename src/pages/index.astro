---
import Layout from "@/layouts/Layout.astro";
import ModuleRow from "@/components/ModuleRow.astro";
import { site } from "@/data/site";
import { getCollection } from "astro:content";

const products = (await getCollection("products")).filter((product) => product.data.kind === "som");
---

<Layout description={site.description}>
  <section class="border-b border-divider">
    <div class="shell section-hero">
      <h1>
        <img src="/logo.svg" alt={site.name} class="hero-logo" />
      </h1>
      <p class="mt-8 max-w-xl text-lg leading-relaxed text-muted">{site.tagline}</p>
    </div>
  </section>

  <section>
    <div class="shell section">
      <h2 class="title">Products</h2>
      <div class="mt-8">
        {products.map((product) => <ModuleRow product={product} heading="h3" />)}
      </div>
    </div>
  </section>
</Layout>
