---
import Layout from "@/layouts/Layout.astro";
import { getCollection, render } from "astro:content";

export async function getStaticPaths() {
  const articles = await getCollection("docs");
  return articles.map((article) => ({
    params: { id: article.id },
    props: { article, articles },
  }));
}

const { article, articles } = Astro.props;
const { Content } = await render(article);
const others = articles
  .filter((item) => item.id !== article.id)
  .sort((a, b) => a.data.order - b.data.order);
---

<Layout title={article.data.title} description={article.data.description}>
  <article class="shell max-w-3xl py-16 lg:py-20">
    <p class="eyebrow">Docs</p>
    <h1 class="display mt-4">{article.data.title}</h1>
    <p class="lead mt-5">{article.data.description}</p>
    <div class="prose-lab mt-12">
      <Content />
    </div>
    <nav class="mt-16 border-t border-line pt-8" aria-label="Other primers">
      <p class="font-mono text-[11px] uppercase tracking-[0.18em] text-muted">Also in docs</p>
      <ul class="mt-4 grid gap-2 sm:grid-cols-2">
        {
          others.map((item) => (
            <li>
              <a class="text-sm text-lab hover:underline" href={`/docs/${item.id}`}>
                {item.data.title}
              </a>
            </li>
          ))
        }
      </ul>
      <p class="mt-8 font-mono text-[11px] uppercase tracking-[0.16em]">
        <a class="text-lab hover:underline" href="/docs">← All docs</a>
      </p>
    </nav>
  </article>
</Layout>
