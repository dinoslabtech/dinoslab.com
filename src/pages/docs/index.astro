---
import Layout from "@/layouts/Layout.astro";
import PageIntro from "@/components/PageIntro.astro";
---

<Layout
  title="Docs"
  description="Datasheets and bring-up notes for Dino’s Lab modules. Nothing published yet."
>
  <div class="shell py-16 lg:py-20">
    <PageIntro kicker="Docs" title="Documentation">
      Pinouts, datasheets, and bring-up notes will land here with the first
      module. Nothing to download yet.
    </PageIntro>

    <div class="panel mt-12">
      <div class="flex items-center justify-between border-b border-line px-5 py-2.5 text-sm text-muted">
        <span>Library</span>
        <span>Empty</span>
      </div>
      <div class="px-5 py-16 text-center">
        <p class="text-sm text-muted">
          Waiting on the N6?{" "}
          <a class="text-lab underline underline-offset-2" href="/products">Leave a note</a>
          {" "}and we’ll send the docs when they exist.
        </p>
      </div>
    </div>
  </div>
</Layout>
