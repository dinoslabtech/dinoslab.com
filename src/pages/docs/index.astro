---
import Layout from "@/layouts/Layout.astro";
import PageIntro from "@/components/PageIntro.astro";
import { getCollection } from "astro:content";

const articles = (await getCollection("docs")).sort((a, b) => a.data.order - b.data.order);
---

<Layout
  title="Docs"
  description="Short primers on the buses, packages, and memories used on Dino’s Lab boards."
>
  <div class="shell py-16 lg:py-20">
    <PageIntro kicker="Docs" title="Documentation">
      Primers for the silicon and buses on the DNL-N6. Datasheets, pinouts, and
      bring-up notes will follow the first hardware.
    </PageIntro>

    <ul class="mt-12 divide-y divide-line border-y border-line">
      {
        articles.map((article) => (
          <li>
            <a href={`/docs/${article.id}`} class="group grid gap-2 py-8 sm:grid-cols-[10rem_1fr] sm:gap-10">
              <p class="font-mono text-[11px] uppercase tracking-[0.16em] text-lab">
                {String(article.data.order).padStart(2, "0")}
              </p>
              <div>
                <h2 class="text-xl font-medium tracking-tight group-hover:text-lab">{article.data.title}</h2>
                <p class="mt-2 text-sm text-muted">{article.data.description}</p>
              </div>
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</Layout>
