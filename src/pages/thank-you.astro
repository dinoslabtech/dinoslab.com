---
import Layout from "@/layouts/Layout.astro";
import { site } from "@/data/site";
---

<Layout title="Sent" description="We have the message." noindex>
  <div class="shell max-w-xl py-24">
    <p class="eyebrow">Sent</p>
    <h1 class="display mt-3">Got it.</h1>
    <p class="lead mt-5">
      We will answer from {site.email}, or on Telegram if that is easier.
    </p>
    <a href="/" class="btn-secondary mt-10">Back to the lab</a>
  </div>
</Layout>
