---
import Layout from "@/layouts/Layout.astro";
import { site } from "@/data/site";
---

<Layout title="Sent" description="We have the message." noindex>
  <div class="mx-auto max-w-xl px-4 py-24 text-center sm:px-6">
    <h1 class="text-3xl font-semibold tracking-tight">Got it.</h1>
    <p class="mt-4 text-muted">
      We will answer from {site.email}, or on Telegram if that is easier.
    </p>
    <a href="/" class="mt-8 inline-block text-sm font-medium text-lab hover:underline">
      Back to the lab
    </a>
  </div>
</Layout>
