---
import Layout from "@/layouts/Layout.astro";
import { site } from "@/data/site";
---

<Layout title="Sent" description="Message received." noindex>
  <div class="shell max-w-xl py-24">
    <p class="eyebrow">Sent</p>
    <h1 class="display mt-3">Received.</h1>
    <p class="lead mt-5">
      Reply will come from {site.email}.
    </p>
    <a href="/" class="btn-secondary mt-10">Home</a>
  </div>
</Layout>
