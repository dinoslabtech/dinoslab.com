---
import Layout from "@/layouts/Layout.astro";
---

<Layout title="Not found" noindex>
  <div class="shell max-w-xl py-24">
    <p class="eyebrow">404</p>
    <h1 class="display mt-3">That page isn’t here.</h1>
    <p class="lead mt-5">The address doesn’t match anything on the site.</p>
    <a href="/" class="btn-secondary mt-10">Home</a>
  </div>
</Layout>
