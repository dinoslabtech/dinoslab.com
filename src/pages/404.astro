---
import Layout from "@/layouts/Layout.astro";
---

<Layout title="Not found" noindex>
  <div class="mx-auto max-w-xl px-4 py-24 text-center sm:px-6">
    <p class="font-mono text-sm text-lab">404</p>
    <h1 class="mt-2 text-3xl font-semibold tracking-tight">This page is not on the board.</h1>
    <p class="mt-4 text-muted">The URL does not match anything we ship.</p>
    <a href="/" class="mt-8 inline-block text-sm font-medium text-lab hover:underline">
      Home
    </a>
  </div>
</Layout>
