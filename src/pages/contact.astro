---
import Layout from "@/layouts/Layout.astro";
import ContactForm from "@/components/ContactForm.astro";
import ContactLinks from "@/components/ContactLinks.astro";
---

<Layout
  title="Contact"
  description="Email Dino's Lab about a board or production."
>
  <div class="shell section grid gap-8 lg:grid-cols-12 lg:gap-12">
    <div class="lg:col-span-5">
      <h1 class="title">Contact</h1>
      <div class="mt-10">
        <ContactLinks github location />
      </div>
    </div>

    <div class="panel-raised h-fit p-6 sm:p-8 lg:col-span-7">
      <ContactForm />
    </div>
  </div>
</Layout>
