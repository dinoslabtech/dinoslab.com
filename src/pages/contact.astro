---
import Layout from "@/layouts/Layout.astro";
import PageIntro from "@/components/PageIntro.astro";
import ContactForm from "@/components/ContactForm.astro";
import { site } from "@/data/site";
---

<Layout
  title="Contact"
  description="Email, SIM, or Telegram. Dino’s Lab is in Ladispoli / Rome and works worldwide."
>
  <div class="shell grid gap-12 py-16 lg:grid-cols-12 lg:py-20">
    <div class="lg:col-span-5">
      <PageIntro kicker="Contact" title="Ask us directly.">
        Quotes, module interest, or a short question. We answer in English.
      </PageIntro>

      <dl class="mt-10 divide-y divide-line border-y border-line">
        <div class="py-4">
          <dt class="font-mono text-[11px] uppercase tracking-[0.16em] text-muted">Email</dt>
          <dd class="mt-1">
            <a class="text-lg hover:text-lab" href={`mailto:${site.email}`}>{site.email}</a>
          </dd>
        </div>
        <div class="py-4">
          <dt class="font-mono text-[11px] uppercase tracking-[0.16em] text-muted">SIM</dt>
          <dd class="mt-1">
            <a class="text-lg hover:text-lab" href={`tel:${site.phone.replace(/\s/g, "")}`}>
              {site.phone}
            </a>
          </dd>
        </div>
        <div class="py-4">
          <dt class="font-mono text-[11px] uppercase tracking-[0.16em] text-muted">Telegram</dt>
          <dd class="mt-1">
            <a class="text-lg hover:text-lab" href={site.telegram}>{site.telegramHandle}</a>
          </dd>
        </div>
        <div class="py-4">
          <dt class="font-mono text-[11px] uppercase tracking-[0.16em] text-muted">GitHub</dt>
          <dd class="mt-1">
            <a class="text-lg hover:text-lab" href={site.github}>{site.githubHandle}</a>
          </dd>
        </div>
        <div class="py-4">
          <dt class="font-mono text-[11px] uppercase tracking-[0.16em] text-muted">Studio</dt>
          <dd class="mt-1 text-lg">{site.location}</dd>
        </div>
      </dl>
    </div>

    <div class="panel h-fit p-6 sm:p-8 lg:col-span-7">
      <p class="font-mono text-[11px] uppercase tracking-[0.18em] text-muted">Message</p>
      <p class="mt-2 text-sm text-muted">
        For a board quote, use <a class="underline underline-offset-2 hover:text-lab" href="/consulting">consulting</a>.
        This form is for everything else.
      </p>
      <div class="mt-6">
        <ContactForm />
      </div>
    </div>
  </div>
</Layout>
