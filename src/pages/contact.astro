---
import Layout from "@/layouts/Layout.astro";
import PageIntro from "@/components/PageIntro.astro";
import ContactForm from "@/components/ContactForm.astro";
import ContactLinks from "@/components/ContactLinks.astro";
---

<Layout
  title="Contact"
  description="Email Dino’s Lab. Ladispoli (Rome), Italy."
>
  <div class="shell grid gap-12 py-16 lg:grid-cols-12 lg:py-20">
    <div class="lg:col-span-5">
      <PageIntro kicker="Contact" title="Contact">
        Email.
      </PageIntro>
      <div class="mt-10">
        <ContactLinks github location />
      </div>
    </div>

    <div class="panel h-fit p-6 sm:p-8 lg:col-span-7">
      <p class="text-sm font-medium">Message</p>
      <p class="mt-2 text-sm text-muted">
        For a design or production quote, see{" "}
        <a class="underline underline-offset-2 hover:text-lab" href="/consulting">consulting</a>.
      </p>
      <div class="mt-6">
        <ContactForm />
      </div>
    </div>
  </div>
</Layout>
