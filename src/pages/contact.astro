---
import Layout from "@/layouts/Layout.astro";
import PageIntro from "@/components/PageIntro.astro";
import ContactForm from "@/components/ContactForm.astro";
import ContactLinks from "@/components/ContactLinks.astro";
---

<Layout
  title="Contact"
  description="Email Dino’s Lab about a board, production, or a question that is not a product waitlist."
>
  <div class="shell grid gap-12 py-16 lg:grid-cols-12 lg:py-20">
    <div class="lg:col-span-5">
      <PageIntro title="Contact">
        Email about a board, production, or a question that is not a product waitlist. For the DNL-N6, register interest on the <a class="text-lab underline underline-offset-2" href="/products/dnl-n6#interest">product page</a>.
      </PageIntro>
      <div class="mt-10">
        <ContactLinks github location />
      </div>
    </div>

    <div class="panel h-fit p-6 sm:p-8 lg:col-span-7">
      <ContactForm />
    </div>
  </div>
</Layout>
