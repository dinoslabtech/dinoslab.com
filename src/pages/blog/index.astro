---
import Layout from "@/layouts/Layout.astro";
import { getCollection } from "astro:content";

const posts = (await getCollection("blog")).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
---

<Layout
  title="Blog"
  description="Notes from Dino’s Lab — firmware, Linux, and hardware as we write them."
>
  <div class="mx-auto max-w-3xl px-4 py-16 sm:px-6">
    <p class="text-sm font-medium uppercase tracking-wider text-lab">Blog</p>
    <h1 class="mt-2 text-4xl font-semibold tracking-tight">Notes</h1>
    <p class="mt-4 text-lg text-muted">
      Practical write-ups. No filler.
    </p>

    <ul class="mt-12 space-y-8">
      {
        posts.map((post) => (
          <li class="border-t border-line pt-8">
            <p class="font-mono text-xs text-muted">
              <time datetime={post.data.pubDate.toISOString()}>
                {post.data.pubDate.toLocaleDateString("en-GB", {
                  year: "numeric",
                  month: "long",
                  day: "numeric",
                })}
              </time>
              {" · "}
              {post.data.author}
            </p>
            <h2 class="mt-2 text-2xl font-semibold">
              <a class="hover:text-lab" href={`/blog/${post.id}`}>
                {post.data.title}
              </a>
            </h2>
            <p class="mt-2 text-muted">{post.data.description}</p>
          </li>
        ))
      }
    </ul>
  </div>
</Layout>
