---
import Layout from "@/layouts/Layout.astro";
import PageIntro from "@/components/PageIntro.astro";
import { getCollection } from "astro:content";

const posts = (await getCollection("blog")).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
---

<Layout
  title="Blog"
  description="Notes from Dino’s Lab on firmware, Linux, and hardware."
>
  <div class="shell py-16 lg:py-20">
    <PageIntro kicker="Blog" title="Notes">
      Firmware, Linux, hardware — written when we have something useful to say.
    </PageIntro>

    <ul class="mt-12 divide-y divide-line border-y border-line">
      {
        posts.map((post) => (
          <li>
            <a href={`/blog/${post.id}`} class="group grid gap-3 py-8 sm:grid-cols-[10rem_1fr] sm:gap-10">
              <p class="font-mono text-[11px] uppercase tracking-[0.12em] text-muted">
                <time datetime={post.data.pubDate.toISOString()}>
                  {post.data.pubDate.toLocaleDateString("en-GB", {
                    year: "numeric",
                    month: "short",
                    day: "2-digit",
                  })}
                </time>
              </p>
              <div>
                <h2 class="text-xl font-medium tracking-tight group-hover:text-lab">
                  {post.data.title}
                </h2>
                <p class="mt-2 text-sm text-muted">{post.data.description}</p>
                <p class="mt-3 font-mono text-[11px] text-muted">{post.data.author}</p>
              </div>
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</Layout>
