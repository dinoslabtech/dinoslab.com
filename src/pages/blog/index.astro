---
import Layout from "@/layouts/Layout.astro";
import PageIntro from "@/components/PageIntro.astro";
import { getCollection } from "astro:content";

const posts = (await getCollection("blog")).sort((a, b) => {
  const byDate = b.data.pubDate.valueOf() - a.data.pubDate.valueOf();
  if (byDate !== 0) return byDate;
  return (a.data.order ?? 99) - (b.data.order ?? 99);
});
---

<Layout
  title="Blog"
  description="Notes on the buses and memories on the DNL-N6, and other lab writing."
>
  <div class="shell section">
    <PageIntro title="Blog">
      Notes on the buses and memories on the DNL-N6, and the odd Linux piece.
    </PageIntro>

    <ul class="mt-8 divide-y divide-line border-y border-line">
      {
        posts.map((post) => (
          <li>
            <a href={`/blog/${post.id}`} class="group grid gap-3 py-8 sm:grid-cols-[10rem_1fr] sm:gap-10">
              <p class="font-mono text-[11px] uppercase tracking-[0.12em] text-muted">
                <time datetime={post.data.pubDate.toISOString()}>
                  {post.data.pubDate.toLocaleDateString("en-GB", {
                    year: "numeric",
                    month: "short",
                    day: "2-digit",
                  })}
                </time>
              </p>
              <div>
                <h2 class="text-xl font-medium tracking-tight group-hover:text-lab">
                  {post.data.title}
                </h2>
                <p class="mt-2 text-sm text-muted">{post.data.description}</p>
                <p class="mt-3 font-mono text-[11px] text-muted">{post.data.author}</p>
              </div>
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</Layout>
