---
import Layout from "@/layouts/Layout.astro";
import { getCollection, render } from "astro:content";

export async function getStaticPaths() {
  const posts = await getCollection("blog");
  return posts.map((post) => ({
    params: { id: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);
---

<Layout title={post.data.title} description={post.data.description}>
  <article class="mx-auto max-w-3xl px-4 py-16 sm:px-6">
    <p class="font-mono text-xs text-muted">
      <time datetime={post.data.pubDate.toISOString()}>
        {
          post.data.pubDate.toLocaleDateString("en-GB", {
            year: "numeric",
            month: "long",
            day: "numeric",
          })
        }
      </time>
      {" · "}
      {post.data.author}
    </p>
    <h1 class="mt-3 text-4xl font-semibold tracking-tight">{post.data.title}</h1>
    <p class="mt-4 text-lg text-muted">{post.data.description}</p>
    <div
      class="prose prose-neutral mt-12 max-w-none prose-headings:font-semibold prose-a:text-lab prose-code:font-mono prose-pre:bg-ink prose-pre:text-paper"
    >
      <Content />
    </div>
    <p class="mt-16 border-t border-line pt-6 text-sm">
      <a class="text-lab hover:underline" href="/blog">← All notes</a>
    </p>
  </article>
</Layout>
