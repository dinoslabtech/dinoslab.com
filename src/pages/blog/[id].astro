---
import Layout from "@/layouts/Layout.astro";
import { getCollection, render } from "astro:content";

export async function getStaticPaths() {
  const posts = await getCollection("blog");
  return posts.map((post) => ({
    params: { id: post.id },
    props: { post, posts },
  }));
}

const { post, posts } = Astro.props;
const { Content } = await render(post);
const related = posts
  .filter((item) => item.id !== post.id && item.data.tags.includes("n6") && post.data.tags.includes("n6"))
  .sort((a, b) => (a.data.order ?? 99) - (b.data.order ?? 99));
---

<Layout title={post.data.title} description={post.data.description}>
  <article class="shell max-w-3xl py-16 lg:py-20">
    <p class="font-mono text-[11px] uppercase tracking-[0.12em] text-muted">
      <time datetime={post.data.pubDate.toISOString()}>
        {
          post.data.pubDate.toLocaleDateString("en-GB", {
            year: "numeric",
            month: "long",
            day: "numeric",
          })
        }
      </time>
      {" · "}
      {post.data.author}
    </p>
    <h1 class="display mt-4">{post.data.title}</h1>
    <p class="lead mt-5">{post.data.description}</p>
    <div class="prose-lab mt-12">
      <Content />
    </div>
    {
      related.length > 0 && (
        <nav class="mt-16 border-t border-line pt-8" aria-label="Related articles">
          <p class="font-mono text-[11px] uppercase tracking-[0.18em] text-muted">Related articles</p>
          <ul class="mt-4 grid gap-2 sm:grid-cols-2">
            {related.map((item) => (
              <li>
                <a class="text-sm text-lab hover:underline" href={`/blog/${item.id}`}>
                  {item.data.title}
                </a>
              </li>
            ))}
          </ul>
        </nav>
      )
    }
    <p class="mt-10 font-mono text-[11px] uppercase tracking-[0.16em]">
      <a class="text-lab hover:underline" href="/blog">← All articles</a>
    </p>
  </article>
</Layout>
