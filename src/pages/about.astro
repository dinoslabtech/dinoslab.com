---
import Layout from "@/layouts/Layout.astro";
import PageIntro from "@/components/PageIntro.astro";
import { site } from "@/data/site";
---

<Layout
  title="About"
  description="Dino’s Lab designs solder-down modules in Ladispoli. Boards are built by Acme Systems."
>
  <div class="shell section">
    <PageIntro title="About">
      Solder-down modules, designed in Ladispoli, built by Acme Systems.
    </PageIntro>

    <div class="mt-10 grid gap-8 lg:grid-cols-12">
      <div class="space-y-5 text-[17px] leading-relaxed text-muted lg:col-span-7">
        <p>
          Dino’s Lab is the brand. The first board is the DNL-N6, an STM32N6 SoM
          for a carrier you design, with a DevKit to bring the module up. This
          site is the technical home: datasheets, pinouts, and notes when they exist.
        </p>
        <p>
          Boards are manufactured by{" "}
          <a class="text-ink underline decoration-line underline-offset-2 hover:text-lab" href={site.acme.url}>
            {site.acme.name}
          </a>
          in Ladispoli: SMT pick-and-place, vapour-phase reflow, through-hole
          completion, and test. When the N6 is for sale, the buy button will go
          to their shop.
        </p>
        <p>
          Custom schematic, layout, firmware, and assembly is available on request
          — a side path, not the product line.{" "}
          <a class="text-ink underline decoration-line underline-offset-2 hover:text-lab" href="/consulting">
            Request a quote
          </a>.
        </p>
      </div>

      <dl class="h-fit divide-y divide-line border-y border-line lg:col-span-5">
        <div class="grid grid-cols-[7rem_1fr] gap-4 py-4 text-sm">
          <dt class="font-mono text-[11px] uppercase tracking-[0.16em] text-muted">Location</dt>
          <dd>{site.location}</dd>
        </div>
        <div class="grid grid-cols-[7rem_1fr] gap-4 py-4 text-sm">
          <dt class="font-mono text-[11px] uppercase tracking-[0.16em] text-muted">Production</dt>
          <dd>
            <a class="hover:text-lab" href={site.acme.url}>{site.acme.name}</a>
          </dd>
        </div>
        <div class="grid grid-cols-[7rem_1fr] gap-4 py-4 text-sm">
          <dt class="font-mono text-[11px] uppercase tracking-[0.16em] text-muted">GitHub</dt>
          <dd>
            <a class="hover:text-lab" href={site.github}>{site.githubHandle}</a>
          </dd>
        </div>
        <div class="grid grid-cols-[7rem_1fr] gap-4 py-4 text-sm">
          <dt class="font-mono text-[11px] uppercase tracking-[0.16em] text-muted">Email</dt>
          <dd>
            <a class="hover:text-lab" href={`mailto:${site.email}`}>{site.email}</a>
          </dd>
        </div>
      </dl>
    </div>
  </div>
</Layout>
