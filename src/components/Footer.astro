---
import { site, nav } from "@/data/site";
const year = new Date().getFullYear();
---

<footer class="border-t border-line bg-white">
  <div class="mx-auto grid max-w-6xl gap-10 px-4 py-14 sm:px-6 md:grid-cols-4">
    <div class="md:col-span-2">
      <div class="flex items-center gap-3">
        <img src="/logo-mark.svg" alt="" width="32" height="32" class="h-8 w-8" />
        <span class="font-semibold">{site.name}</span>
      </div>
      <p class="mt-4 max-w-sm text-sm leading-relaxed text-muted">
        {site.tagline} Independent studio in {site.location}. Production with{" "}
        <a class="underline decoration-line underline-offset-2 hover:text-lab" href={site.acme.url}>
          {site.acme.name}
        </a>.
      </p>
    </div>

    <div>
      <p class="text-xs font-semibold uppercase tracking-wider text-muted">Studio</p>
      <ul class="mt-3 space-y-2 text-sm">
        {nav.map((item) => (
          <li>
            <a class="hover:text-lab" href={item.href}>{item.label}</a>
          </li>
        ))}
        <li>
          <a class="hover:text-lab" href="/contact">Contact</a>
        </li>
      </ul>
    </div>

    <div>
      <p class="text-xs font-semibold uppercase tracking-wider text-muted">Talk to us</p>
      <ul class="mt-3 space-y-2 text-sm">
        <li>
          <a class="hover:text-lab" href={`mailto:${site.email}`}>{site.email}</a>
        </li>
        <li>
          <a class="hover:text-lab" href={`tel:${site.phone.replace(/\s/g, "")}`}>{site.phone}</a>
        </li>
        <li>
          <a class="hover:text-lab" href={site.telegram}>Telegram {site.telegramHandle}</a>
        </li>
        <li>
          <a class="hover:text-lab" href={site.github}>GitHub {site.githubHandle}</a>
        </li>
        <li class="text-muted">{site.location}</li>
      </ul>
    </div>
  </div>
  <div class="border-t border-line">
    <p class="mx-auto max-w-6xl px-4 py-5 text-xs text-muted sm:px-6">
      © {year} {site.legalName}. English-speaking studio. We work worldwide.
    </p>
  </div>
</footer>
