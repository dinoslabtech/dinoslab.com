---
import { site, nav } from "@/data/site";
const year = new Date().getFullYear();
---

<footer class="mt-auto border-t border-line bg-void">
  <div class="shell grid gap-10 py-12 sm:gap-12 sm:py-14 md:grid-cols-12">
    <div class="md:col-span-5">
      <div class="flex items-center gap-2.5">
        <img src="/logo-mark.svg" alt="" width="28" height="28" class="h-7 w-7" />
        <span class="text-[15px] font-medium">{site.name}</span>
      </div>
      <p class="mt-4 max-w-sm text-sm leading-relaxed text-muted">
        {site.tagline} Independent studio in {site.location}. Boards assembled with{" "}
        <a class="text-ink underline decoration-line underline-offset-2 hover:text-lab" href={site.acme.url}>
          {site.acme.name}
        </a>.
      </p>
    </div>

    <div class="md:col-span-3">
      <p class="font-mono text-[11px] uppercase tracking-[0.2em] text-muted">Studio</p>
      <ul class="mt-4 space-y-2 text-sm text-muted">
        {nav.map((item) => (
          <li>
            <a class="inline-flex min-h-11 items-center hover:text-ink" href={item.href}>{item.label}</a>
          </li>
        ))}
        <li>
          <a class="inline-flex min-h-11 items-center hover:text-ink" href="/contact">Contact</a>
        </li>
      </ul>
    </div>

    <div class="md:col-span-4">
      <p class="font-mono text-[11px] uppercase tracking-[0.2em] text-muted">Contact</p>
      <ul class="mt-4 space-y-1 text-sm text-muted">
        <li>
          <a class="inline-flex min-h-11 items-center hover:text-ink" href={`mailto:${site.email}`}>{site.email}</a>
        </li>
        <li>
          <a class="inline-flex min-h-11 items-center hover:text-ink" href={`tel:${site.phone.replace(/\s/g, "")}`}>
            {site.phone}
            <span class="ml-2 text-muted/70">· SIM</span>
          </a>
        </li>
        <li>
          <a class="inline-flex min-h-11 items-center hover:text-ink" href={site.telegram}>Telegram {site.telegramHandle}</a>
        </li>
        <li>
          <a class="inline-flex min-h-11 items-center hover:text-ink" href={site.github}>GitHub {site.githubHandle}</a>
        </li>
        <li class="pt-1">{site.location}</li>
      </ul>
    </div>
  </div>
  <div class="border-t border-line">
    <div class="shell flex flex-col gap-2 py-4 pb-[max(1rem,env(safe-area-inset-bottom))] font-mono text-[11px] tracking-wide text-muted sm:flex-row sm:justify-between">
      <p>© {year} {site.legalName}</p>
      <p>English · Worldwide</p>
    </div>
  </div>
</footer>
