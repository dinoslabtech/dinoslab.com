---
interface Props {
  kicker?: string;
  title: string;
  class?: string;
}

const { kicker, title, class: className } = Astro.props;
---

<header class:list={["max-w-2xl", className]}>
  {kicker && <p class="eyebrow">{kicker}</p>}
  <h1 class:list={["display", kicker && "mt-3"]}>{title}</h1>
  {
    Astro.slots.has("default") && (
      <p class="lead mt-5">
        <slot />
      </p>
    )
  }
</header>
