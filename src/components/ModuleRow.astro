---
import type { CollectionEntry } from "astro:content";
import { productStatusLabel } from "@/data/site";

interface Props {
  product: CollectionEntry<"products">;
  heading?: "h2" | "h3";
}

const { product, heading = "h2" } = Astro.props;
const Heading = heading;
const { highlights, variants, summary, title, status } = product.data;
---

<a href={`/products/${product.id}`} class="group block border-y border-divider py-8">
  <p class="eyebrow">{productStatusLabel[status]}</p>
  <Heading class="mt-3 text-2xl font-medium tracking-tight group-hover:text-accent-text">
    {title}
  </Heading>
  <p class="mt-2 max-w-2xl text-muted">{summary}</p>
  {
    variants && variants.length > 0 && (
      <p class="mt-4 font-mono text-sm text-muted">{variants.map((sku) => sku.code).join(" · ")}</p>
    )
  }
  {
    highlights && highlights.length > 0 && (
      <div class="facts-grid mt-8">
        {highlights.map((item) => (
          <div class="facts-cell">
            <p class="facts-value">{item.value}</p>
            <p class="facts-label">{item.label}</p>
          </div>
        ))}
      </div>
    )
  }
</a>
