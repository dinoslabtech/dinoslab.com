---
import type { CollectionEntry } from "astro:content";
import { productStatusLabel } from "@/data/site";

interface Props {
  product: CollectionEntry<"products">;
  heading?: "h2" | "h3";
}

const { product, heading = "h2" } = Astro.props;
const Heading = heading;
const { highlights, summary, title, status } = product.data;
const infos = highlights ?? [];
---

<a href={`/products/${product.id}`} class="panel group block overflow-hidden">
  <div class="p-6 sm:p-8">
    <p class="eyebrow">{productStatusLabel[status]}</p>
    <Heading class="mt-3 text-2xl font-medium tracking-tight group-hover:text-accent-text">
      {title}
    </Heading>
    <p class="mt-2 max-w-2xl text-muted">{summary}</p>
  </div>
  {
    infos.length > 0 && (
      <div class="grid grid-cols-2 gap-px border-t border-divider bg-divider sm:grid-cols-3 lg:grid-cols-6">
        {infos.map((item) => (
          <div class="facts-cell">
            <p class="facts-value">{item.value}</p>
            <p class="facts-label">{item.label}</p>
          </div>
        ))}
      </div>
    )
  }
</a>
