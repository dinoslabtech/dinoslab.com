---
interface Props {
  name: "mail" | "phone" | "telegram" | "github" | "pin";
  class?: string;
}

const { name, class: className = "h-4 w-4" } = Astro.props;
---

{
  name === "mail" && (
    <svg class={className} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true">
      <rect x="3" y="5" width="18" height="14" rx="1.5" />
      <path d="M4 7l8 6 8-6" />
    </svg>
  )
}
{
  name === "phone" && (
    <svg class={className} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true">
      <path d="M6.5 3.8h3.2l1.2 3.2-2 1.2a12 12 0 0 0 6.7 6.7l1.2-2 3.2 1.2v3.2c0 .7-.6 1.4-1.4 1.4C10.8 18.7 5.3 13.2 5.3 5.2c0-.8.6-1.4 1.2-1.4Z" />
    </svg>
  )
}
{
  name === "telegram" && (
    <svg class={className} viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
      <path d="M21.5 4.3 18.2 20c-.2 1-1.3 1.3-2.1.8l-5.4-4-2.6 2.5c-.3.3-.8.1-.9-.3l-.4-4.8L3 12.3c-1-.3-1-1.7.1-2L20.2 3.6c.9-.4 1.8.4 1.3 1.7Z" />
    </svg>
  )
}
{
  name === "github" && (
    <svg class={className} viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
      <path d="M12 2a10 10 0 0 0-3.2 19.5c.5.1.7-.2.7-.5v-1.7c-2.8.6-3.4-1.2-3.4-1.2-.5-1.1-1.1-1.4-1.1-1.4-.9-.6.1-.6.1-.6 1 .1 1.5 1 1.5 1 .9 1.5 2.4 1.1 3 .8.1-.6.4-1.1.6-1.3-2.2-.3-4.6-1.1-4.6-5 0-1.1.4-2 1-2.7-.1-.3-.4-1.3.1-2.7 0 0 .8-.3 2.8 1a9.6 9.6 0 0 1 5 0c2-.1 2.8-1 2.8-1 .5 1.4.2 2.4.1 2.7.7.7 1 1.6 1 2.7 0 3.9-2.3 4.7-4.6 5 .4.3.7 1 .7 2v2.2c0 .3.2.6.7.5A10 10 0 0 0 12 2Z" />
    </svg>
  )
}
{
  name === "pin" && (
    <svg class={className} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true">
      <path d="M12 21s6-5.2 6-10a6 6 0 1 0-12 0c0 4.8 6 10 6 10Z" />
      <circle cx="12" cy="11" r="1.8" />
    </svg>
  )
}
