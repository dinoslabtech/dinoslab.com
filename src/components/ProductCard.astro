---
interface Props {
  href: string;
  category: string;
  title: string;
  chip: string;
  summary: string;
  heading?: "h2" | "h3";
}

const { href, category, title, chip, summary, heading = "h2" } = Astro.props;
const Heading = heading;
---

<a href={href} class="panel group flex flex-col overflow-hidden transition-colors hover:border-lab">
  <div class="flex items-center justify-between border-b border-line px-5 py-2.5">
    <span class="font-mono text-[11px] uppercase tracking-[0.18em] text-lab">{category}</span>
    <span class="badge">Coming soon</span>
  </div>
  <div class="flex flex-1 flex-col px-5 py-6">
    <Heading class="text-2xl font-medium tracking-tight group-hover:text-lab">{title}</Heading>
    <p class="mt-2 font-mono text-xs text-muted">{chip}</p>
    <p class="mt-4 text-sm leading-relaxed text-muted">{summary}</p>
    <p class="mt-6 font-mono text-[11px] uppercase tracking-[0.16em] text-lab">
      View module <span aria-hidden="true" class="font-sans">→</span>
    </p>
  </div>
</a>
