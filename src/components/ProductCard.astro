---
import { productStatusLabel } from "@/data/site";

interface Props {
  href: string;
  category: string;
  title: string;
  chip: string;
  summary: string;
  status: keyof typeof productStatusLabel;
  heading?: "h2" | "h3";
  featured?: boolean;
}

const {
  href,
  category,
  title,
  chip,
  summary,
  status,
  heading = "h2",
  featured = false,
} = Astro.props;
const Heading = heading;
---

<a
  href={href}
  class:list={[
    "panel group overflow-hidden transition-[border-color,box-shadow,background-color] duration-150 hover:border-highlight hover:bg-raised hover:shadow-[var(--shadow-sm)]",
    featured ? "grid" : "flex flex-col",
  ]}
>
  <div class="flex flex-col">
    <div class="flex flex-wrap items-center justify-between gap-2 border-b border-line px-4 py-2.5 sm:px-5">
      <span class="font-mono text-[11px] uppercase tracking-[0.18em] text-lab">{category}</span>
      <span class="badge">{productStatusLabel[status]}</span>
    </div>
    <div class="flex flex-1 flex-col px-5 py-6 sm:px-6 sm:py-8">
      <Heading
        class:list={[
          "font-medium tracking-tight group-hover:text-lab",
          featured ? "text-3xl" : "text-2xl",
        ]}
      >
        {title}
      </Heading>
      <p class="mt-2 font-mono text-xs text-muted">{chip}</p>
      <p class="mt-4 text-sm leading-relaxed text-muted">{summary}</p>
      <p class="mt-6 font-mono text-[11px] uppercase tracking-[0.16em] text-lab">
        Details <span aria-hidden="true" class="font-sans">→</span>
      </p>
    </div>
  </div>
</a>
