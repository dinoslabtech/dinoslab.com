<figure class="diagram" aria-label="DNL-N6 block diagram. Power and memory on the module.">
  <div class="diagram-row">
    <p class="diagram-kicker">Power</p>
    <div class="diagram-flow">
      <div class="diagram-box">5–24 V in</div>
      <span class="diagram-arrow" aria-hidden="true">→</span>
      <div class="diagram-stack">
        <div class="diagram-box">3.3 V → MCU</div>
        <div class="diagram-box">1.8 V → PSRAM, NOR</div>
      </div>
    </div>
  </div>

  <div class="diagram-row">
    <p class="diagram-kicker">Memory</p>
    <div class="diagram-flow">
      <div class="diagram-box diagram-box-core">STM32N657X0</div>
      <span class="diagram-arrow" aria-hidden="true">→</span>
      <div class="diagram-stack">
        <div class="diagram-box"><span class="diagram-bus">XSPI</span> 2×64 MB or 1×64 MB PSRAM</div>
        <div class="diagram-box"><span class="diagram-bus">XSPI</span> 128 MB octal NOR</div>
      </div>
    </div>
  </div>
</figure>
