---
interface Node {
  kicker: string;
  title: string;
  body: string;
}

interface Props {
  nodes: Node[];
}

const { nodes } = Astro.props;
---

<div class="mod-diagram" role="img" aria-label="DNL-N6 block diagram">
  {
    nodes.map((node) => (
      <div class="mod-node">
        <p class="font-mono text-[10px] uppercase tracking-[0.18em] text-lab">{node.kicker}</p>
        <p class="mt-2 text-lg font-medium tracking-tight">{node.title}</p>
        <p class="mt-1 text-sm leading-relaxed text-muted">{node.body}</p>
      </div>
    ))
  }
</div>
